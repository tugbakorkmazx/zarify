NEXT_PUBLIC_API_URL=http://localhost:5097
# Public origin of the site itself — used for absolute share-preview (Open
# Graph) image URLs. Production builds fail without both variables.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional, `next dev` only — open the dev server from a phone on the same
# network without exposing the API: the dev server forwards /api/* to it.
#   DEV_ALLOWED_ORIGINS=192.168.1.20          (this machine's LAN address)
#   DEV_API_PROXY=http://localhost:5097
#   NEXT_PUBLIC_API_URL=http://192.168.1.20:3000
#   NEXT_PUBLIC_SITE_URL=http://192.168.1.20:3000
# then: npx next dev -H 0.0.0.0
