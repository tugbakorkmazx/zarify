# ---------------------------------------------------------------------------
# Secrets & local config — never commit
# ---------------------------------------------------------------------------
# DB connection string and JWT key live in .NET user-secrets (outside the repo):
#   dotnet user-secrets set "ConnectionStrings:Default" "..."
#   dotnet user-secrets set "Jwt:Key" "..."
.env
.env.*
!.env.example
appsettings.Development.json
appsettings.*.local.json
secrets.json
*.pfx
*.p12
*.pem
*.key

# ---------------------------------------------------------------------------
# Frontend (Next.js)
# ---------------------------------------------------------------------------
node_modules/
.next/
out/
coverage/
*.tsbuildinfo
next-env.d.ts
.vercel
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---------------------------------------------------------------------------
# Backend (.NET)
# ---------------------------------------------------------------------------
[Bb]in/
[Oo]bj/
.vs/
*.user
*.suo
*.rsuser
TestResults/

# ---------------------------------------------------------------------------
# Editor / OS
# ---------------------------------------------------------------------------
.idea/
.DS_Store
Thumbs.db
desktop.ini
*.log

# ---------------------------------------------------------------------------
# AI tooling installed per machine
# ---------------------------------------------------------------------------
# Third-party agent skills — reinstallable from skills-lock.json. The
# .claude/skills entries are symlinks with absolute paths to this machine.
.agents/
.claude/skills/
.claude/settings.local.json

# ---------------------------------------------------------------------------
# Unlicensed art — never commit
# ---------------------------------------------------------------------------
# Raw downloads used while exploring the design, and the retired gravure /
# herbarium set in gorseller/_arsiv/. None of it is licensed and the site
# no longer uses any of it (every image the site shows is registered in
# frontend/src/lib/art.ts and lives in frontend/public/images/art/). Kept
# on disk only, outside public/ so no build can ever serve it.
/gorseller/

# Raw AI-generated image exports for the current art set (see ASSETS.md):
# kept on disk as the provenance record, never committed — the optimised
# WebP versions in frontend/public/images/art/ are what the site uses.
/zarify-yeni-gorseller/
